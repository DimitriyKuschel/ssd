# SSD Docker Configuration
# Copy this file to .env and adjust values as needed:
#   cp .env.sample .env

# Host port mapping
SSD_PORT=8090

# Data and logs directories on the host machine
SSD_DATA_DIR=./data
SSD_LOGS_DIR=./logs

# Application settings
SSD_LOG_LEVEL=info
SSD_AGGREGATION_INTERVAL=60s
SSD_SAVE_INTERVAL=120s

# Cache settings
SSD_CACHE_ENABLED=true
SSD_CACHE_SIZE=32

# Metrics settings
SSD_METRICS_ENABLED=true

# Statistics limits
SSD_MAX_CHANNELS=1000
SSD_MAX_RECORDS=-1
SSD_EVICTION_PERCENT=10
SSD_MAX_RECORDS_PER_FP=-1

# Fingerprint TTL and cold storage
SSD_FINGERPRINT_TTL=0
SSD_COLD_STORAGE_DIR=
SSD_COLD_TTL=0
